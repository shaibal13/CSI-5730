LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY part1 IS
	PORT(SW : IN STD_LOGIC_VECTOR(0 TO 7);
		HEXO,HEX1 : OUT STD_LOGIC_VECTOR(0 TO 6));
END part1;

ARCHITECTURE SevenSegment of part1 IS
	SIGNAL HEXO7SEGMENT, HEX1SEGMENT : STD_LOGIC_VECTOR(O TO 3);
	BEGIN
	HEX07SEGMENT <= SW(0 TO 3);
	HEX17SEGMENT <=SW(0 TO 3);
	--HEXO EQUATION 
	
	HEX0(0) <= HEX07SEGMENT(0) OR HEX07SEGMENT(2) OR (HEX07SEGMENT(1) AND HEX07SEGMENT(3)) 
					OR (((NOT)HEX07SEGMENT(1)) AND ((NOT)HEX07SEGMENT(3)));
					
	HEX0(1)  <= ((NOT)HEX07SEGMENT(1)) OR (((NOT)HEX07SEGMENT(2) AND (NOT)HEX07SEGMENT(3))) OR (HEX07SEGMENT(2)
					AND HEX07SEGMENT(3));
					
	HEX0(2) <=  HEX07SEGMENT(1) OR (NOT)HEX07SEGMENT(2) OR HEX07SEGMENT(3);
	
	HEX0(3) <= ((NOT)HEX07SEGMENT(1) AND (NOT)HEX07SEGMENT(3)) OR (HEX07SEGMENT(2) AND ((NOT)HEX07SEGMENT(3))) OR
					(HEX07SEGMENT(1) AND ((NOT)HEX07SEGMENT(2)) AND HEX07SEGMENT(3)) OR ((NOT)HEX07SEGMENT(1)
					AND HEX07SEGMENT(2)) OR (HEX07SEGMENT(0));
					
	HEX0(4) <= ((NOT)HEX07SEGMENT(1) AND HEX07SEGMENT(3)) OR (HEX07SEGMENT(3) AND ((NOT)HEX07SEGMENT(3)));
	
	HEX0(5) <= HEX07SEGMENT(0) OR (((NOT)HEX07SEGMENT(2)) AND ((NOT)HEX07SEGMENT(3))) OR (HEX07SEGMENT(1)
					AND ((NOT)HEX07SEGMENT(2))) OR (HEX07SEGMENT(1) AND ((NOT) HEX07SEGMENT(3)));
					
	HEX0(6) <= (((NOT)HEX07SEGMENT(1)) AND HEX07SEGMENT(2)) OR (HEX07SEGMENT(2) AND ((NOT)HEX07SEGMENT(3))) OR
					(HEX07SEGMENT(1) AND ((NOT)HEX07SEGMENT(2))) OR HEX07SEGMENT(0);
	

END SeveNSegment;