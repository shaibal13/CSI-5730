LIBRARY ieee;
use ieee.std_logic_1164.all;
ENTITY sevensegmentdecoderusing2bitwidemux IS
PORT(
	SW	: IN	STD_LOGIC_VECTOR(9 DOWNTO 0);
	LEDR : OUT STD_LOGIC_VECTOR(9 DOWNTO 0);
	
	HEX0,HEX1,HEX2,HEX3: OUT STD_LOGIC_VECTOR(0 TO 6)
	

);
END sevensegmentdecoderusing2bitwidemux;

ARCHITECTURE Behavior OF sevensegmentdecoderusing2bitwidemux IS 
	COMPONENT twobitwide4to1multiplexer
		PORT ( s, u, v, w, x	: IN	STD_LOGIC_VECTOR(1 DOWNTO 0); 
		 m	: OUT	STD_LOGIC_VECTOR(1 DOWNTO 0));
	END COMPONENT;

	
	COMPONENT sevensegmentdecoder
		PORT ( c	: IN	STD_LOGIC_VECTOR(1 DOWNTO 0); 
				 Display	: OUT	STD_LOGIC_VECTOR(0 TO 6));
				 
		END COMPONENT;
		
		SIGNAL M0,M1,M2,M3 : STD_LOGIC_VECTOR(1 DOWNTO 0);
	
	BEGIN
		-- Get the output of 4*1 and use this for 7 sengment 
		U3: twobitwide4to1multiplexer PORT MAP (SW(9 DOWNTO 8), SW(7 DOWNTO 6), SW(5 DOWNTO 4), SW(3 DOWNTO 2), SW(1 DOWNTO 0), M0);
		U2: twobitwide4to1multiplexer PORT MAP (SW(9 DOWNTO 8),  SW(5 DOWNTO 4), SW(3 DOWNTO 2), SW(1 DOWNTO 0),SW(7 DOWNTO 6), M1);
		U1: twobitwide4to1multiplexer PORT MAP (SW(9 DOWNTO 8), SW(3 DOWNTO 2), SW(1 DOWNTO 0),SW(7 DOWNTO 6),SW(5 DOWNTO 4), M2);
		U0: twobitwide4to1multiplexer PORT MAP (SW(9 DOWNTO 8), SW(1 DOWNTO 0),SW(7 DOWNTO 6),SW(5 DOWNTO 4),SW(3 DOWNTO 2), M3);
		-- Four 7 segment 
		H3: sevensegmentdecoder PORT MAP (M0, HEX3);
		H2: sevensegmentdecoder PORT MAP (M1, HEX2);
		H1: sevensegmentdecoder PORT MAP (M2, HEX1);
		H0: sevensegmentdecoder PORT MAP (M3, HEX0);
		LEDR <= SW;

END Behavior;


LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY twobitwide4to1multiplexer IS
--input and output 
	PORT(
	  s: IN STD_LOGIC_VECTOR(1 DOWNTO 0); 	--input select in Mux
	  u: IN STD_LOGIC_VECTOR(1 DOWNTO 0);	--input u
	  v: IN STD_LOGIC_VECTOR(1 DOWNTO 0);	--input w
	  w: IN STD_LOGIC_VECTOR(1 DOWNTO 0);	--input x
	  x: IN STD_LOGIC_VECTOR(1 DOWNTO 0);	--input x
	  
	  m: OUT STD_LOGIC_VECTOR(1 DOWNTO 0));	--output m
END twobitwide4to1multiplexer;

ARCHITECTURE BEHAVIOR OF twobitwide4to1multiplexer IS
BEGIN
	m(0)  <=      u(0) when (s(0)='0' AND s(1)='0') 
      else v(0) when  (s(0)='0' AND s(1)='1')
		 else w(0) when  (s(0)='1' AND s(1)='0') 
		 else x(0);
		 
		 
	m(1)  <=      u(1) when (s(0)='0' AND s(1)='0') 
      else v(1) when  (s(0)='0' AND s(1)='1')
		 else w(1) when  (s(0)='1' AND s(1)='0') 
		 else x(1);
	
  

END BEHAVIOR;


-- THis is four substance of 4 7 segment display

LIBRARY ieee;
use ieee.std_logic_1164.all;
ENTITY sevensegmentdecoder IS
PORT(
	C: IN STD_LOGIC_VECTOR(1 DOWNTO 0);
	--C0: IN STD_LOGIC;
	Display: OUT STD_LOGIC_VECTOR(0 TO 6)
	
);
END sevensegmentdecoder;

ARCHITECTURE BEHAVIOR OF sevensegmentdecoder IS

BEGIN

	  Display(0)<= not(((not (c(1))) AND (c(0))) OR (c(0) AND c(1)));
	  Display(1)<= not(((not(c(1)) ) AND not(c(0))) OR (c(1) AND not(c(0))) OR (c(0) AND c(1)));
	  Display(2)<= not(((not(c(1)) ) AND not(c(0))) OR (c(1) AND not(c(0))) OR (c(0) AND c(1)));
	  Display(3)<= not(((not(c(1)) ) AND not(c(0))) OR (c(0) AND not(c(1))) OR (c(0) AND c(1)));
	  Display(4)<= not(((not(c(1)) ) AND not(c(0))) OR (c(0) AND not(c(1))) OR (c(0) AND c(1)));
	  Display(5)<= not(((not (c(1))) AND (c(0))) OR (c(0) AND c(1)));
	  Display(6)<= not(((not(c(1)) ) AND not(c(0))) OR (c(0) AND not(c(1))) OR (c(0) AND c(1)));
	

END BEHAVIOR;